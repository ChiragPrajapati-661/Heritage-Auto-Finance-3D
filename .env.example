# Public frontend configuration for the Heritage Auto Finance enquiry form.
# Copy this file to .env.local and fill in values from your Supabase project.
# Use the publishable key (sb_publishable_...) or legacy anon key only.
# NEVER put a service_role or secret key in a VITE_ variable.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_LEGACY_ANON_KEY
